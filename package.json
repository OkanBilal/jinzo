{
  "name": "jinzo",
  "type": "commonjs",
  "productName": "jinzo",
  "version": "0.1.0",
  "description": "AI-powered developer workspace",
  "main": ".vite/build/main.js",
  "publish": {
    "provider": "github",
    "owner": "laurelresearch",
    "repo": "jinzo"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:runtime": "drizzle-kit studio --config drizzle.config.runtime.ts",
    "db:clean:dev": "rm -f .data/jinzo.db .data/jinzo.db-shm .data/jinzo.db-wal && npm run db:push",
    "db:clean:runtime": "rm -f ~/Library/Application\\ Support/jinzo/jinzo.db ~/Library/Application\\ Support/jinzo/jinzo.db-shm ~/Library/Application\\ Support/jinzo/jinzo.db-wal && echo 'Runtime database cleaned. Restart the app to recreate.'",
    "db:clean:all": "npm run db:clean:dev && npm run db:clean:runtime",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "reset": "npm rebuild better-sqlite3 && npm run db:clean:dev && rm -f .data/jinzo.db",
    "hard-reset": "npm run reset && rm -rf node_modules package-lock.json .vite dist .webpack && npm install",
    "clean": "rm -rf .vite dist out .webpack node_modules/.vite node_modules/.cache"
  },
  "keywords": [],
  "author": {
    "name": "Okan Bilal Balcı",
    "email": "obbalci@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/jinzo.git"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "OWNER",
      "repo": "jinzo"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^8.3.4",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "electron": "40.6.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@anthropic-ai/sdk": "^0.78.0",
    "@github/copilot-sdk": "^0.1.29",
    "@linear/sdk": "^75.0.0",
    "@lottiefiles/dotlottie-react": "^0.18.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@number-flow/react": "^0.5.14",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "^1.0.11",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.3",
    "frimousse": "^0.3.0",
    "motion": "^12.34.2",
    "nanoid": "^5.1.6",
    "node-pty": "^1.1.0",
    "ollama": "^0.6.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "redux-persist": "^6.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "simple-git": "^3.31.1",
    "sqlite-vec": "^0.1.7-alpha.2"
  },
  "overrides": {
    "tar": "^7.5.6",
    "esbuild": "^0.25.0",
    "tmp": "^0.2.5"
  }
}
