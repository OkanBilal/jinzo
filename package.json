{
  "name": "jinzo",
  "productName": "jinzo",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "db:seed:apps": "tsx src/main/db/queries/seed-apps.ts",
    "db:seed:connections": "tsx src/main/db/queries/seed-connections.ts",
    "db:seed": "npm run db:seed:apps && npm run db:seed:connections",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:runtime": "drizzle-kit studio --config drizzle.config.runtime.ts",
    "db:clean:dev": "rm -f .data/jinzo.db .data/jinzo.db-shm .data/jinzo.db-wal && npm run db:push",
    "db:clean:runtime": "rm -f ~/Library/Application\\ Support/jinzo/jinzo.db ~/Library/Application\\ Support/jinzo/jinzo.db-shm ~/Library/Application\\ Support/jinzo/jinzo.db-wal && echo 'Runtime database cleaned. Restart the app to recreate.'",
    "db:clean:all": "npm run db:clean:dev && npm run db:clean:runtime",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [],
  "author": {
    "name": "Okan Bilal Balcı",
    "email": "obbalci@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.2",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "electron": "40.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@blocknote/core": "^0.46.1",
    "@blocknote/mantine": "^0.46.1",
    "@blocknote/react": "^0.46.1",
    "@lottiefiles/dotlottie-react": "^0.17.13",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@number-flow/react": "^0.5.10",
    "@octokit/rest": "^22.0.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "electron-squirrel-startup": "^1.0.1",
    "frimousse": "^0.3.0",
    "motion": "^12.27.5",
    "nanoid": "^5.1.6",
    "ollama": "^0.6.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.12.0",
    "redux-persist": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.7-alpha.2"
  },
  "overrides": {
    "tar": "^7.5.6",
    "esbuild": "^0.25.0",
    "tmp": "^0.2.5"
  }
}
