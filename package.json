{
  "name": "mains",
  "type": "commonjs",
  "productName": "mains",
  "version": "0.2.2",
  "description": "AI-powered developer workspace",
  "main": ".vite/build/main.js",
  "publish": {
    "provider": "github",
    "owner": "OkanBilal",
    "repo": "mains"
  },
  "scripts": {
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "test:coverage": "npm rebuild better-sqlite3 && vitest run --coverage",
    "start": "ulimit -n 65536 && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:runtime": "drizzle-kit studio --config drizzle.config.runtime.ts",
    "db:clean:dev": "rm -f .data/mains.db .data/mains.db-shm .data/mains.db-wal .data/mains.db.pre-migration-backup*",
    "db:clean:runtime": "rm -f ~/Library/Application\\ Support/mains/mains.db ~/Library/Application\\ Support/mains/mains.db-shm ~/Library/Application\\ Support/mains/mains.db-wal && echo 'Runtime database cleaned. Restart the app to recreate.'",
    "db:clean:all": "npm run db:clean:dev && npm run db:clean:runtime",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "reset": "npm rebuild better-sqlite3 && npm run db:clean:dev",
    "hard-reset": "npm run reset && rm -rf node_modules package-lock.json .vite dist .webpack && npm install",
    "clean": "rm -rf .vite dist out .webpack node_modules/.vite node_modules/.cache"
  },
  "keywords": [
    "electron",
    "ai",
    "developer-tools",
    "github-copilot",
    "claude",
    "workspace",
    "sqlite",
    "react",
    "desktop-app"
  ],
  "author": {
    "name": "Okan Bilal Balcı",
    "email": "obbalci@gmail.com",
    "url": "https://github.com/OkanBilal"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OkanBilal/mains.git"
  },
  "homepage": "https://github.com/OkanBilal/mains#readme",
  "bugs": {
    "url": "https://github.com/OkanBilal/mains/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "OkanBilal",
      "repo": "mains"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.5.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@anthropic-ai/sdk": "^0.97.1",
    "@cursor/sdk": "^1.0.12",
    "@github/copilot-sdk": "^0.3.0",
    "@linear/sdk": "^83.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@number-flow/react": "^0.6.0",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "^1.1.3",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.1",
    "electron-squirrel-startup": "^1.0.1",
    "frimousse": "^0.3.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.15.0",
    "redux-persist": "^6.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.33.0",
    "tailwind-merge": "^3.5.0",
    "update-electron-app": "^3.1.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "^7.5.6",
    "esbuild": "^0.25.0",
    "tmp": "^0.2.5"
  }
}
